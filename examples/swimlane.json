      ]
    },
    {
      "title": "2. Payment Orchestrator",
      "items": [
        { "key": "orch_init", "id": "2.1", "icon": "server", "title": "Init transaction", "desc": "Create pending record", "style": "modified", "row": 1, "standalone": true },
        {
